frame_count = 173;
ticks_per_frame = 2;   # refresh runs ~50Hz, so a steady 25 fps

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# frames are pre-sized at build time: no scaling happens during playback
for (i = 0; i < frame_count; i++) {
  if (i < 10)
    name = "00" + i;
  else if (i < 100)
    name = "0" + i;
  else
    name = "" + i;
  frames[i] = Image("frames/frame-" + name + ".png");
}

sprite = Sprite(frames[0]);
sprite.SetX(Window.GetWidth() / 2 - frames[0].GetWidth() / 2);
sprite.SetY(Window.GetHeight() / 2 - frames[0].GetHeight() / 2);

tick = 0;
frame = 0;
fun refresh_callback () {
  tick++;
  if (tick < ticks_per_frame) return;
  tick = 0;
  frame++;
  if (frame >= frame_count) frame = 0;
  sprite.SetImage(frames[frame]);
}
Plymouth.SetRefreshFunction(refresh_callback);
