#!/usr/bin/env bash
# JellyFace command line. Run `jellyface help` for usage.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/../scripts/lib.sh"

LOG="$JF_ROOT/logs/jellyface.log"
AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/jellyface.desktop"

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
PIDFILE="$RUNTIME/jellyface.pid"
LOG_MAX=$((5 * 1024 * 1024))

# The recorded pid only counts if it is still our supervisor (a recycled pid must not fake "running")
supervisor_pid() {
    local p; p="$(cat "$PIDFILE" 2>/dev/null || true)"
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null && ps -p "$p" -o args= 2>/dev/null | grep -Eq "$JF_SUP_RE" && echo "$p"
}
is_running()     { supervisor_pid >/dev/null; }

rotate_log() {   # keep the logs from growing without bound: current + one previous generation (also while running: run.sh)
    jf_rotate "$LOG" "$LOG_MAX"
    jf_rotate "$JF_ROOT/logs/theme.log" 1048576
}

# With the systemd user service enabled, start/stop/restart from a terminal go through systemd. Otherwise `restart`
# killed the service's supervisor (a clean exit, so systemd did not restart it) and left a hand-started copy running
# outside the service. Inside the service itself (systemd sets INVOCATION_ID) the direct path is used.
use_service() {
    [ -z "${INVOCATION_ID:-}" ] && [ "${JF_NO_SERVICE:-0}" != 1 ] && command -v systemctl >/dev/null &&
        systemctl --user is-enabled --quiet jellyface.service 2>/dev/null
}

cmd_start() {
    local timeout=0 fg=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --timeout) timeout="${2:?--timeout needs seconds}"; shift 2 ;;
            --foreground|-f) fg=1; shift ;;
            *) die "unknown option '$1'" ;;
        esac
    done
    if [ "$fg" = 0 ] && [ "$timeout" = 0 ] && use_service; then
        is_running && ! systemctl --user is-active --quiet jellyface.service && { log "already running (started by hand)"; return 0; }
        systemctl --user start jellyface.service && log "started (systemd user service; log: $LOG)"
        return
    fi
    is_running && { log "already running"; return 0; }
    mkdir -p "$JF_ROOT/logs"; rotate_log
    if [ "$fg" = 1 ]; then
        # as the systemd service: same log file as a hand-started shell (the journal only gets start/stop lines)
        [ -n "${INVOCATION_ID:-}" ] && exec "$JF_ROOT/scripts/run.sh" "$timeout" >>"$LOG" 2>&1
        exec "$JF_ROOT/scripts/run.sh" "$timeout"
    fi
    setsid nohup "$JF_ROOT/scripts/run.sh" "$timeout" >>"$LOG" 2>&1 </dev/null &
    log "started (log: $LOG)$([ "$timeout" -gt 0 ] && echo ", stops after ${timeout}s")"
}

cmd_stop() {
    # Stopping the shell while its lock screen is up is safe (COSMIC's lock screen takes over) but makes you type the
    # password again; from a terminal or script it is almost always a mistake (e.g. a restart while you are away).
    if [ -z "${INVOCATION_ID:-}" ] && [ "${JF_FORCE:-0}" != 1 ] && locked_by_shell; then
        die "the screen is locked by JellyFace; not stopping it now (JF_FORCE=1 overrides)"
    fi
    if use_service && systemctl --user is-active --quiet jellyface.service; then
        systemctl --user stop jellyface.service    # its ExecStopPost runs this command again, inside the service
    fi
    local p; p="$(supervisor_pid || true)"
    if [ -z "$p" ]; then
        pkill -f "$JF_QS_RE" 2>/dev/null && log "stopped stray shell" || log "not running"
        lock_handover
        return 0
    fi
    kill "$p" 2>/dev/null || true       # the supervisor's trap stops the shell and helper too
    for _ in $(seq 1 20); do is_running || break; sleep 0.5; done
    is_running && kill -9 "$p" 2>/dev/null || true
    # wait until the shell and helper are really gone (force-kill after 5s)
    for _ in $(seq 1 25); do
        pgrep -f "$JF_QS_RE|$JF_WSD_RE|$JF_WIND_RE" >/dev/null || break
        sleep 0.2
    done
    pkill -9 -f "$JF_QS_RE|$JF_WSD_RE|$JF_WIND_RE" 2>/dev/null || true
    lock_handover
    log "stopped"
}

cmd_status() {
    if is_running; then log "supervisor: running (pid $(supervisor_pid))"; else log "supervisor: stopped"; fi
    if systemctl --user is-enabled --quiet jellyface.service 2>/dev/null; then
        log "service: enabled, $(systemctl --user is-active jellyface.service 2>/dev/null)"
    fi
    if pgrep -f "$JF_QS_RE" >/dev/null; then log "shell: running"; else log "shell: stopped"; fi
    if pgrep -f "$JF_WSD_RE" >/dev/null; then log "workspace helper: running"; else log "workspace helper: stopped"; fi
}
cmd_ipc() {
    # JellyPanel socket skips container round trip
    local sock="${XDG_RUNTIME_DIR:-/tmp}/jellyface-jellypanel.sock"
    if [ "${1:-}" = jellypanel ] && [[ "${2:-}" =~ ^(toggle|open|close)$ ]] && [ -S "$sock" ] && command -v nc >/dev/null; then
        printf '%s\n' "$2" | nc -NU "$sock" 2>/dev/null && return 0
    fi
    in_container 'quickshell ipc -p "$1" call "${@:2}"' "$JF_SHELL" "$@"
}

cmd_autostart() {
    case "${1:-}" in
        on)  mkdir -p "$(dirname "$AUTOSTART")"
             printf '[Desktop Entry]\nType=Application\nName=JellyFace\nExec=%s start\nX-GNOME-Autostart-enabled=true\n' "$(desktop_quote "$JF_ROOT/bin/jellyface")" > "$AUTOSTART"
             log "autostart enabled ($AUTOSTART)" ;;
        off) if [ -e "$AUTOSTART" ]; then
                 mkdir -p "$JF_BACKUPS"    # a fresh checkout has no backups/ yet; without it the move failed and autostart stayed on
                 mv "$AUTOSTART" "$JF_BACKUPS/jellyface.desktop.disabled.$(date +%s)" || die "could not disable autostart ($AUTOSTART)"
             fi
             log "autostart disabled" ;;
        *)   die "usage: jellyface autostart on|off" ;;
    esac
}

cmd_doctor() {
    local ok=1
    chk() { if eval "$2" >/dev/null 2>&1; then log "ok    $1"; else warn "FAIL  $1  ->  $3"; ok=0; fi; }
    chk "COSMIC session"          '[ "${XDG_CURRENT_DESKTOP:-}" = "COSMIC" ]' "run this from a COSMIC desktop session"
    chk "distrobox installed"     'command -v distrobox' "sudo apt install distrobox podman"
    chk "container '$JF_CONTAINER'" container_exists "run: jellyface install"
    chk "wallpaper theming (python3-gi + palette pack)" 'python3 -I -c "import gi; gi.require_version(\"GdkPixbuf\",\"2.0\")" && [ "$(python3 -I "$JF_ROOT/scripts/theme.py" list | wc -l)" -gt 0 ]' "sudo apt install python3-gi gir1.2-gdkpixbuf-2.0; put a palette pack in Color_Palette/"
    chk "COSMIC theme tool built" '[ -x "$JF_ROOT/tools/cosmic-theme/target/release/jellyface-cosmic-theme" ]' "run: jellyface build (optional: only needed for theming COSMIC apps)"
    chk "native applet built"     '[ -x "$JF_ROOT/native/jellyface-applet/target/release/jellyface-applet" ]' "run: jellyface build (optional)"
    chk "COSMIC helpers built"    '[ -x "$JF_ROOT/helpers/cosmic-ws/wsd" ] && [ -x "$JF_ROOT/helpers/cosmic-windows/wind" ]' "run: jellyface build"
    chk "shell plugin built"      '[ -d "$JF_INSTALL/qml" ]' "run: jellyface build"
    chk "workspace protocol"      ws_ready "compositor lacks ext-workspace-v1?"
    for f in "$JF_CONFIG_DIR/shell.json" "$JF_CONFIG_DIR/shell-tokens.json" "$JF_STATE_DIR/scheme.json"; do
        chk "valid JSON: ${f/#$HOME/~}" "python3 -I -c 'import json,sys;json.load(open(sys.argv[1]))' $(printf %q "$f")" "fix or restore from config/"
    done
    chk "lock screen rejects a wrong password" 'd=$(mktemp -d); ! printf "wrong-password\0" | XDG_RUNTIME_DIR="$d" PAM_USER="$USER" "$JF_ROOT/scripts/pam-host-check.sh"; rc=$?; rm -rf "$d"; [ $rc -eq 0 ]' "the lock screen would accept anything; do not rely on it"
    chk "lock screen PAM stack is the host-checking one" 'grep -q pam-host-check.sh "$JF_SHELL/assets/pam.d/passwd" && ! grep -q nullok "$JF_SHELL/assets/pam.d/passwd"' "run: jellyface restart (regenerates it)"
    chk "Qt/Quickshell pinned in the container" 'in_container "pacman-conf IgnorePkg" | grep -qx quickshell-git' "re-run: jellyface install (a container upgrade could otherwise break the shell plugin)"
    chk "COSMIC lock screen available as fallback" 'pgrep -x cosmic-greeter' "COSMIC's locker is not running; if JellyFace ever stopped while locked, nothing would take over"
    chk "screen stays on while locked" '[ "$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/com.system76.CosmicIdle/v1/screen_off_time" 2>/dev/null)" = None ]' "run: jellyface cosmic-tweaks"
    if systemctl --user is-enabled --quiet jellyface.service 2>/dev/null && is_running; then
        chk "running under the systemd service" 'systemctl --user is-active --quiet jellyface.service' "it was started by hand; run: jellyface restart"
    fi
    container_exists && log "info  $(in_container 'quickshell --version' 2>/dev/null | head -1) (tested: 0.3.2, revision 4f508be)"
    if command -v nvidia-smi >/dev/null; then
        chk "NVIDIA driver/module match" 'nvidia-smi' "driver update pending -- reboot (a mismatch can cause a grey screen)"
    fi
    [ "$ok" = 1 ] && log "all checks passed" || { warn "some checks failed"; return 1; }
}

usage() { cat <<USAGE
JellyFace -- a desktop shell for COSMIC (Pop!_OS)

  jellyface install               set up the container, build everything, install default config
  jellyface build                 rebuild the workspace helper and the shell plugin
  jellyface start [--timeout N] [--foreground]
                                  start the shell (--timeout N exits after N seconds: safe for testing)
  jellyface stop | restart | status
  jellyface ipc <target> <fn> [args]   e.g.  jellyface ipc drawers toggle launcher
  jellyface lock                  lock the screen with JellyFace's own lock screen (Super+L does the same)
  jellyface notify [-u low|normal|critical] [-a app] [-i icon] SUMMARY [BODY]
                                  send a desktop notification (e.g. to test the notification panel)
  jellyface focus on|off|status   focus follows the cursor (type in whichever window the pointer is over)
  jellyface tiling on|off|status  automatic tiling of windows (COSMIC's tiling window manager)
  jellyface cosmic-dock hide|show|status   hide COSMIC's own dock (JellyFace has its own)
  jellyface cosmic-panel hide|show|status  hide COSMIC's own top panel (JellyFace has its own)
  jellyface integrate [--yes]     make JellyFace part of the COSMIC session (service, panel, lock, applet, theme)
  jellyface applet install|panel-add|panel-remove|remove   the JellyFace menu as a native COSMIC panel applet
  jellyface service on|off|status start JellyFace with the COSMIC session (systemd user service)
  jellyface revert-system [--list]  undo every change JellyFace made outside its own folder
  jellyface autostart on|off      start JellyFace at login
  jellyface theme apply|match|list|auto|status   wallpaper-driven colour themes (see: jellyface theme --help)
  jellyface glass [on|off]        frosted-glass look that adapts to any wallpaper (off = wallpaper palettes)
  jellyface files install|update|theme|status   the yazi terminal file manager in JellyFace's colours
  jellyface fix-icons             create icon aliases from config/icon-aliases.txt (e.g. Flatpak VLC tray icon)
  jellyface agenda set <ics-path|ical-url>   choose the calendar for the desktop Agenda card (also: agenda, agenda status)
  jellyface cosmic-tweaks [--revert]   auto-hide COSMIC's own top panel (backs it up first)
  jellyface greeter test|window|install|status|...   JellyFace as the login screen (self-healing; see greeter/)
  jellyface mail [refresh|status|set-password|set-account]
                                  sync and configure a Gmail inbox (IMAP app password)
  jellyface demo-island [--auto]  interactive demo showcase for Dynamic Island animations
  jellyface pop-all [seconds]     pop out all panels and popouts at once for N seconds (default: 5)
  jellyface doctor                check that everything is in place
USAGE
}

case "${1:-help}" in
    install)       shift; exec "$JF_ROOT/scripts/install.sh" "$@" ;;
    build)         shift; exec "$JF_ROOT/scripts/build.sh" "$@" ;;
    start)         shift; cmd_start "$@" ;;
    stop)          cmd_stop ;;
    restart)       shift; : > "${XDG_RUNTIME_DIR:-/tmp}/jellyface.restarting"; cmd_stop; sleep 1; cmd_start "$@" ;;
    status)        cmd_status ;;
    ipc)           shift; cmd_ipc "$@" ;;
    autostart)     shift; cmd_autostart "$@" ;;
    lock)          exec "$0" ipc lock lock ;;
    overview)      shift; exec cosmic-workspaces "$@" ;;
    cosmic-dock)   shift; exec "$JF_ROOT/scripts/cosmic-dock.sh" "$@" ;;
    cosmic-panel)  shift; exec "$JF_ROOT/scripts/cosmic-panel.sh" "$@" ;;
    tiling)        shift; exec "$JF_ROOT/scripts/tiling.sh" "$@" ;;
    files)         shift; exec "$JF_ROOT/scripts/yazi.sh" "$@" ;;
    focus)         shift; exec "$JF_ROOT/scripts/focus.sh" "$@" ;;
    notify)        shift; exec "$JF_ROOT/scripts/shims/notify-send" "$@" ;;
    integrate)     shift; exec "$JF_ROOT/scripts/integrate.sh" "$@" ;;
    applet)        shift; exec "$JF_ROOT/scripts/applet.sh" "$@" ;;
    service)       shift; exec "$JF_ROOT/scripts/service.sh" "$@" ;;
    revert-system) shift; exec "$JF_ROOT/scripts/revert-system.sh" "$@" ;;
    theme)         shift; exec python3 -I "$JF_ROOT/scripts/theme.py" "$@" ;;
    glass)         shift; exec python3 -I "$JF_ROOT/scripts/theme.py" glass "$@" ;;
    agenda)        shift; exec python3 -I "$JF_ROOT/scripts/agenda.py" "$@" ;;
    mail)          shift; exec python3 -I "$JF_ROOT/scripts/mail.py" "$@" ;;
    fix-icons)     shift; exec "$JF_ROOT/scripts/fix-icons.sh" "$@" ;;
    cosmic-tweaks) shift; exec "$JF_ROOT/scripts/cosmic-tweaks.sh" "$@" ;;
    greeter)       shift; exec "$JF_ROOT/scripts/greeter.sh" "$@" ;;
    demo-island)   shift; exec python3 "$JF_ROOT/tests/demo-island.py" "$@" ;;
    pop-all)       shift; exec "$JF_ROOT/scripts/pop-all.sh" "$@" ;;
    doctor)        cmd_doctor ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
esac
