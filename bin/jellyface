#!/usr/bin/env bash
# JellyFace command line. Run `jellyface help` for usage.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/../scripts/lib.sh"

LOG="$JF_ROOT/logs/jellyface.log"
AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/jellyface.desktop"

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
PIDFILE="$RUNTIME/jellyface.pid"
LOG_MAX=$((5 * 1024 * 1024))

# The recorded pid only counts if it is still our supervisor (a recycled pid must not fake "running")
supervisor_pid() {
    local p; p="$(cat "$PIDFILE" 2>/dev/null || true)"
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null && ps -p "$p" -o args= 2>/dev/null | grep -Eq "$JF_SUP_RE" && echo "$p"
}
is_running()     { supervisor_pid >/dev/null; }

rotate_log() {   # keep the log from growing without bound: current + one previous generation
    [ -f "$LOG" ] && [ "$(stat -c %s "$LOG")" -gt "$LOG_MAX" ] && mv -f "$LOG" "$LOG.1" || true
}

cmd_start() {
    local timeout=0 fg=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --timeout) timeout="${2:?--timeout needs seconds}"; shift 2 ;;
            --foreground|-f) fg=1; shift ;;
            *) die "unknown option '$1'" ;;
        esac
    done
    is_running && { log "already running"; return 0; }
    mkdir -p "$JF_ROOT/logs"; rotate_log
    if [ "$fg" = 1 ]; then exec "$JF_ROOT/scripts/run.sh" "$timeout"; fi
    setsid nohup "$JF_ROOT/scripts/run.sh" "$timeout" >>"$LOG" 2>&1 </dev/null &
    log "started (log: $LOG)$([ "$timeout" -gt 0 ] && echo ", stops after ${timeout}s")"
}

cmd_stop() {
    local p; p="$(supervisor_pid || true)"
    if [ -z "$p" ]; then
        pkill -f "$JF_QS_RE" 2>/dev/null && log "stopped stray shell" || log "not running"
        return 0
    fi
    kill "$p" 2>/dev/null || true       # the supervisor's trap stops the shell and helper too
    for _ in $(seq 1 20); do is_running || break; sleep 0.5; done
    is_running && kill -9 "$p" 2>/dev/null || true
    # wait until the shell and helper are really gone (force-kill after 5s)
    for _ in $(seq 1 25); do
        pgrep -f "$JF_QS_RE|$JF_WSD_RE|$JF_WIND_RE" >/dev/null || break
        sleep 0.2
    done
    pkill -9 -f "$JF_QS_RE|$JF_WSD_RE|$JF_WIND_RE" 2>/dev/null || true
    log "stopped"
}

cmd_status() {
    if is_running; then log "supervisor: running (pid $(supervisor_pid))"; else log "supervisor: stopped"; fi
    if pgrep -f "$JF_QS_RE" >/dev/null; then log "shell: running"; else log "shell: stopped"; fi
    if pgrep -f "$JF_WSD_RE" >/dev/null; then log "workspace helper: running"; else log "workspace helper: stopped"; fi
}
cmd_ipc()     { in_container 'quickshell ipc -p "$1" call "${@:2}"' "$JF_SHELL" "$@"; }

cmd_autostart() {
    case "${1:-}" in
        on)  mkdir -p "$(dirname "$AUTOSTART")"
             printf '[Desktop Entry]\nType=Application\nName=JellyFace\nExec=%s start\nX-GNOME-Autostart-enabled=true\n' "$JF_ROOT/bin/jellyface" > "$AUTOSTART"
             log "autostart enabled ($AUTOSTART)" ;;
        off) [ -e "$AUTOSTART" ] && mv "$AUTOSTART" "$JF_BACKUPS/jellyface.desktop.disabled.$(date +%s)" || true
             log "autostart disabled" ;;
        *)   die "usage: jellyface autostart on|off" ;;
    esac
}

cmd_doctor() {
    local ok=1
    chk() { if eval "$2" >/dev/null 2>&1; then log "ok    $1"; else warn "FAIL  $1  ->  $3"; ok=0; fi; }
    chk "COSMIC session"          '[ "${XDG_CURRENT_DESKTOP:-}" = "COSMIC" ]' "run this from a COSMIC desktop session"
    chk "distrobox installed"     'command -v distrobox' "sudo apt install distrobox podman"
    chk "container '$JF_CONTAINER'" container_exists "run: jellyface install"
    chk "wallpaper theming (python3-gi + palette pack)" 'python3 -I -c "import gi; gi.require_version(\"GdkPixbuf\",\"2.0\")" && [ "$(python3 -I "$JF_ROOT/scripts/theme.py" list | wc -l)" -gt 0 ]' "sudo apt install python3-gi gir1.2-gdkpixbuf-2.0; put a palette pack in Color_Palette/"
    chk "COSMIC theme tool built" '[ -x "$JF_ROOT/tools/cosmic-theme/target/release/jellyface-cosmic-theme" ]' "run: jellyface build (optional: only needed for theming COSMIC apps)"
    chk "native applet built"     '[ -x "$JF_ROOT/native/jellyface-applet/target/release/jellyface-applet" ]' "run: jellyface build (optional)"
    chk "COSMIC helpers built"    '[ -x "$JF_ROOT/helpers/cosmic-ws/wsd" ] && [ -x "$JF_ROOT/helpers/cosmic-windows/wind" ]' "run: jellyface build"
    chk "shell plugin built"      '[ -d "$JF_INSTALL/qml" ]' "run: jellyface build"
    chk "workspace protocol"      ws_ready "compositor lacks ext-workspace-v1?"
    for f in "$JF_CONFIG_DIR/shell.json" "$JF_CONFIG_DIR/shell-tokens.json" "$JF_STATE_DIR/scheme.json"; do
        chk "valid JSON: ${f/#$HOME/~}" "python3 -I -c 'import json,sys;json.load(open(sys.argv[1]))' '$f'" "fix or restore from config/"
    done
    chk "lock screen rejects a wrong password" '! printf "wrong-password\0" | PAM_USER="$USER" "$JF_ROOT/scripts/pam-host-check.sh"' "the lock screen would accept anything; do not rely on it"
    chk "lock screen PAM stack is the host-checking one" 'grep -q pam-host-check.sh "$JF_SHELL/assets/pam.d/passwd" && ! grep -q nullok "$JF_SHELL/assets/pam.d/passwd"' "run: jellyface restart (regenerates it)"
    if command -v nvidia-smi >/dev/null; then
        chk "NVIDIA driver/module match" 'nvidia-smi' "driver update pending -- reboot (a mismatch can cause a grey screen)"
    fi
    [ "$ok" = 1 ] && log "all checks passed" || { warn "some checks failed"; return 1; }
}

usage() { cat <<USAGE
JellyFace -- a Caelestia-based shell for COSMIC (Pop!_OS)

  jellyface install               set up the container, build everything, install default config
  jellyface build                 rebuild the workspace helper and the shell plugin
  jellyface start [--timeout N] [--foreground]
                                  start the shell (--timeout N exits after N seconds: safe for testing)
  jellyface stop | restart | status
  jellyface ipc <target> <fn> [args]   e.g.  jellyface ipc drawers toggle launcher
  jellyface lock                  lock the screen with JellyFace's own lock screen (Super+L does the same)
  jellyface notify [-u low|normal|critical] [-a app] [-i icon] SUMMARY [BODY]
                                  send a desktop notification (e.g. to test the notification panel)
  jellyface focus on|off|status   focus follows the cursor (type in whichever window the pointer is over)
  jellyface tiling on|off|status  automatic tiling of windows (COSMIC's tiling window manager)
  jellyface cosmic-dock hide|show|status   hide COSMIC's own dock (JellyFace has its own)
  jellyface integrate [--yes]     make JellyFace part of the COSMIC session (service, panel, lock, applet, theme)
  jellyface applet install|panel-add|panel-remove|remove   the JellyFace menu as a native COSMIC panel applet
  jellyface service on|off|status start JellyFace with the COSMIC session (systemd user service)
  jellyface revert-system [--list]  undo every change JellyFace made outside its own folder
  jellyface autostart on|off      start JellyFace at login
  jellyface theme apply|match|list|auto|status   wallpaper-driven colour themes (see: jellyface theme --help)
  jellyface fix-icons             create icon aliases from config/icon-aliases.txt (e.g. Flatpak VLC tray icon)
  jellyface cosmic-tweaks [--revert]   auto-hide COSMIC's own top panel (backs it up first)
  jellyface doctor                check that everything is in place
USAGE
}

case "${1:-help}" in
    install)       shift; exec "$JF_ROOT/scripts/install.sh" "$@" ;;
    build)         shift; exec "$JF_ROOT/scripts/build.sh" "$@" ;;
    start)         shift; cmd_start "$@" ;;
    stop)          cmd_stop ;;
    restart)       shift; cmd_stop; sleep 2; cmd_start "$@" ;;
    status)        cmd_status ;;
    ipc)           shift; cmd_ipc "$@" ;;
    autostart)     shift; cmd_autostart "$@" ;;
    lock)          exec "$0" ipc lock lock ;;
    cosmic-dock)   shift; exec "$JF_ROOT/scripts/cosmic-dock.sh" "$@" ;;
    tiling)        shift; exec "$JF_ROOT/scripts/tiling.sh" "$@" ;;
    focus)         shift; exec "$JF_ROOT/scripts/focus.sh" "$@" ;;
    notify)        shift; exec "$JF_ROOT/scripts/shims/notify-send" "$@" ;;
    integrate)     shift; exec "$JF_ROOT/scripts/integrate.sh" "$@" ;;
    applet)        shift; exec "$JF_ROOT/scripts/applet.sh" "$@" ;;
    service)       shift; exec "$JF_ROOT/scripts/service.sh" "$@" ;;
    revert-system) shift; exec "$JF_ROOT/scripts/revert-system.sh" "$@" ;;
    theme)         shift; exec python3 -I "$JF_ROOT/scripts/theme.py" "$@" ;;
    fix-icons)     shift; exec "$JF_ROOT/scripts/fix-icons.sh" "$@" ;;
    cosmic-tweaks) shift; exec "$JF_ROOT/scripts/cosmic-tweaks.sh" "$@" ;;
    doctor)        cmd_doctor ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
esac
