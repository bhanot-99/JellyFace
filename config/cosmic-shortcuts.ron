{
    (modifiers: [Super], key: "l"): Spawn("@JF_ROOT@/bin/jellyface lock"),
    (modifiers: [Super, Shift], key: "f"): Spawn("@JF_ROOT@/bin/jellyface ipc focus toggle"),
    (modifiers: [Super], key: "v"): Spawn("@JF_ROOT@/bin/jellyface ipc clipboard toggle"),
    (modifiers: [Super]): Spawn("@JF_ROOT@/bin/jellyface ipc jellypanel toggle"),
}
