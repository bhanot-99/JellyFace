{
    (modifiers: [Super], key: "space"): Spawn("@JF_ROOT@/bin/jellyface ipc drift toggle command"),
    (modifiers: [Super], key: "c"): Spawn("@JF_ROOT@/bin/jellyface ipc drift toggle cc"),
    (modifiers: [Super], key: "e"): Spawn("@JF_ROOT@/bin/jellyface ipc drift toggle hints"),
    (modifiers: [Super], key: "d"): Spawn("@JF_ROOT@/bin/jellyface ipc drift toggle desks"),
    (modifiers: [Super], key: "w"): Spawn("@JF_ROOT@/bin/jellyface ipc drift toggle desks"),
    (modifiers: [Super], key: "p"): Spawn("@JF_ROOT@/bin/jellyface ipc drift toggle appearance"),
    (modifiers: [Super, Shift], key: "slash"): Spawn("@JF_ROOT@/bin/jellyface ipc drift toggle keys"),
}
