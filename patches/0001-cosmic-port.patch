diff --git a/modules/bar/components/SidebarButton.qml b/modules/bar/components/SidebarButton.qml
new file mode 100644
index 0000000..8238d40
--- /dev/null
+++ b/modules/bar/components/SidebarButton.qml
@@ -0,0 +1,34 @@
+import QtQuick
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// Bell button that toggles the notification sidebar (the click-outside-to-close grab is Hyprland-only)
+Item {
+    id: root
+
+    required property ScreenState screenState
+
+    implicitWidth: icon.implicitHeight + Tokens.padding.small
+    implicitHeight: icon.implicitHeight
+
+    StateLayer {
+        // Cursed workaround to make the height larger than the parent
+        anchors.fill: undefined
+        anchors.centerIn: parent
+        implicitWidth: implicitHeight
+        implicitHeight: icon.implicitHeight + Tokens.padding.small
+        radius: Tokens.rounding.full
+        onClicked: root.screenState.sidebar = !root.screenState.sidebar
+    }
+
+    MaterialIcon {
+        id: icon
+
+        anchors.centerIn: parent
+
+        text: root.screenState.sidebar ? "notifications_active" : "notifications"
+        color: Colours.palette.m3onSurfaceVariant
+        fontStyle: Tokens.font.icon.builders.small.weight(Font.Bold).build()
+    }
+}
diff --git a/modules/bar/components/workspaces/CosmicWorkspaces.qml b/modules/bar/components/workspaces/CosmicWorkspaces.qml
new file mode 100644
index 0000000..5030ea2
--- /dev/null
+++ b/modules/bar/components/workspaces/CosmicWorkspaces.qml
@@ -0,0 +1,55 @@
+import QtQuick
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// Workspace switcher backed by COSMIC's real workspaces
+StyledRect {
+    id: root
+
+    required property var screen
+    required property bool fullscreen
+
+    readonly property int cell: Tokens.sizes.bar.innerWidth - Tokens.padding.extraSmall * 2
+
+    implicitWidth: Tokens.sizes.bar.innerWidth
+    implicitHeight: col.implicitHeight + Tokens.padding.extraSmall * 2
+    visible: !fullscreen
+
+    color: Colours.tPalette.m3surfaceContainer
+    radius: Tokens.rounding.full
+
+    Column {
+        id: col
+
+        anchors.centerIn: parent
+        spacing: Tokens.spacing.extraSmall
+
+        Repeater {
+            model: CosmicWs.list
+
+            StyledRect {
+                id: item
+
+                required property var modelData
+
+                width: root.cell
+                height: root.cell
+                radius: Tokens.rounding.full
+                color: modelData.active ? Colours.palette.m3primary : (modelData.urgent ? Colours.palette.m3error : "transparent")
+
+                StyledText {
+                    anchors.centerIn: parent
+                    text: item.modelData.name
+                    color: item.modelData.active ? Colours.palette.m3onPrimary : Colours.palette.m3onSurfaceVariant
+                }
+
+                MouseArea {
+                    anchors.fill: parent
+                    cursorShape: Qt.PointingHandCursor
+                    onClicked: CosmicWs.activate(item.modelData.i)
+                }
+            }
+        }
+    }
+}
