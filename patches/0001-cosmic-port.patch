@@ -0,0 +1,40 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+// COSMIC workspaces via the ext-workspace-v1 helper (helpers/cosmic-ws)
+Singleton {
+    id: root
+
+    property var list: []
+    readonly property int activeIndex: list.findIndex(w => w.active)
+
+    function activate(i: int): void {
+        proc.write(`activate ${i}\n`);
+    }
+
+    Process {
+        id: proc
+
+        running: true
+        stdinEnabled: true
+        command: [Quickshell.shellPath("../helpers/cosmic-ws/wsd")]
+        stdout: SplitParser {
+            onRead: data => {
+                try {
+                    root.list = JSON.parse(data).ws.filter(w => !w.hidden);
+                } catch (e) {}
+            }
+        }
+        onExited: restartTimer.start()
+    }
+
+    Timer {
+        id: restartTimer
+
+        interval: 2000
+        onTriggered: proc.running = true
+    }
+}
diff --git a/services/FocusMode.qml b/services/FocusMode.qml
new file mode 100644
index 0000000..d2882b2
--- /dev/null
+++ b/services/FocusMode.qml
@@ -0,0 +1,64 @@
+pragma Singleton
+
+import Quickshell
+import Quickshell.Io
+import Jellyface
+import Jellyface.Config
+import Jellyface.I18n
+import qs.services
+
+// Focus mode: one switch for "leave me alone": Do Not Disturb on and the screen kept awake. Turning it off puts both
+// back the way they were before (so it never switches off a DND or keep-awake you turned on yourself).
+Singleton {
+    id: root
+
+    property alias enabled: props.enabled
+
+    function toggle(): void {
+        enabled = !enabled;
+    }
+
+    onEnabledChanged: {
+        if (enabled) {
+            props.hadDnd = Notifs.dnd;
+            props.hadInhibit = IdleInhibitor.enabled;
+            Notifs.dnd = true;
+            IdleInhibitor.enabled = true;
+            Toaster.toast(Tr.tr("Focus mode on"), Tr.tr("Notifications muted and the screen kept awake"), "target");
+        } else {
+            Notifs.dnd = props.hadDnd;
+            IdleInhibitor.enabled = props.hadInhibit;
+            Toaster.toast(Tr.tr("Focus mode off"), Tr.tr("Notifications and screen timeout restored"), "target");
+        }
+    }
+
+    PersistentProperties {
+        id: props
+
+        property bool enabled
+        property bool hadDnd
+        property bool hadInhibit
+
+        reloadableId: "focusMode"
+    }
+
+    IpcHandler {
+        function isEnabled(): bool {
+            return props.enabled;
+        }
+
+        function toggle(): void {
+            props.enabled = !props.enabled;
+        }
+
+        function enable(): void {
+            props.enabled = true;
+        }
+
+        function disable(): void {
+            props.enabled = false;
+        }
+
+        target: "focus"
+    }
+}
