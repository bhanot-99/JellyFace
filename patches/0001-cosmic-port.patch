diff --git a/services/CosmicWindows.qml b/services/CosmicWindows.qml
new file mode 100644
index 0000000..893a2da
--- /dev/null
+++ b/services/CosmicWindows.qml
@@ -0,0 +1,41 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+// COSMIC windows (focused window, fullscreen state) via the cosmic-toplevel-info helper (helpers/cosmic-windows).
+// Quickshell's own toplevel support needs wlr-foreign-toplevel-management, which COSMIC does not offer.
+Singleton {
+    id: root
+
+    property var windows: []
+    property int activeId: 0
+    property bool fullscreen: false
+    readonly property var active: windows.find(w => w.id === activeId) ?? null
+
+    Process {
+        id: proc
+
+        running: true
+        command: [Quickshell.shellPath("../helpers/cosmic-windows/wind")]
+        stdout: SplitParser {
+            onRead: data => {
+                try {
+                    const d = JSON.parse(data);
+                    root.windows = d.windows;
+                    root.activeId = d.active;
+                    root.fullscreen = d.fullscreen;
+                } catch (e) {}
+            }
+        }
+        onExited: restartTimer.start()
+    }
+
+    Timer {
+        id: restartTimer
+
+        interval: 2000
+        onTriggered: proc.running = true
+    }
+}
diff --git a/services/CosmicWs.qml b/services/CosmicWs.qml
new file mode 100644
index 0000000..a32ce3b
--- /dev/null
+++ b/services/CosmicWs.qml
@@ -0,0 +1,40 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+// COSMIC workspaces via the ext-workspace-v1 helper (helpers/cosmic-ws)
+Singleton {
+    id: root
+
+    property var list: []
+    readonly property int activeIndex: list.findIndex(w => w.active)
+
+    function activate(i: int): void {
+        proc.write(`activate ${i}\n`);
+    }
+
+    Process {
+        id: proc
+
+        running: true
+        stdinEnabled: true
+        command: [Quickshell.shellPath("../helpers/cosmic-ws/wsd")]
+        stdout: SplitParser {
+            onRead: data => {
+                try {
+                    root.list = JSON.parse(data).ws.filter(w => !w.hidden);
+                } catch (e) {}
+            }
+        }
+        onExited: restartTimer.start()
+    }
+
+    Timer {
+        id: restartTimer
+
+        interval: 2000
+        onTriggered: proc.running = true
+    }
+}
