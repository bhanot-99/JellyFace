#!/usr/bin/env bash
# Minimal notify-send (libnotify is installed neither on the host nor in the container, so every notification the shell
# tried to send -- "Screenshot taken", "Profile picture changed" -- was silently lost). Sends through the session bus
# with gdbus. Supports: -a APP  -u low|normal|critical  -i ICON  -t MS  -h TYPE:NAME:VALUE  SUMMARY [BODY]
set -u
app="notify-send" icon="" urgency=1 timeout=-1; hints=""
gv() { local s="${1//\\/\\\\}"; s="${s//\'/\\\'}"; s="${s//$'\n'/\\n}"; printf "'%s'" "$s"; }   # GVariant string
while [ $# -gt 0 ]; do
    case "$1" in
        # options that take a value: a missing value (flag last on the line) ends parsing instead of looping or failing
        -a|--app-name|-u|--urgency|-i|--icon|-t|--expire-time|-h|--hint|-c|--category|-r|--replace-id|-A|--action)
            [ $# -ge 2 ] || { shift; break; } ;;
    esac
    case "$1" in
        -a|--app-name) app="$2"; shift 2 ;;
        -u|--urgency)  case "$2" in low) urgency=0;; critical) urgency=2;; *) urgency=1;; esac; shift 2 ;;
        -i|--icon)     icon="$2"; shift 2 ;;
        -t|--expire-time) [[ "$2" =~ ^-?[0-9]+$ ]] && timeout="$2"; shift 2 ;;
        -h|--hint)     IFS=: read -r type name value <<<"$2"
                       case "$type" in
                           STRING) hints+=", $(gv "$name"): <$(gv "$value")>" ;;
                           INT|int)   [[ "$value" =~ ^-?[0-9]+$ ]] && hints+=", $(gv "$name"): <int32 $value>" ;;
                           BYTE|byte) [[ "$value" =~ ^[0-9]+$ ]] && hints+=", $(gv "$name"): <byte $value>" ;;
                       esac; shift 2 ;;
        -e|--transient) shift ;;                                   # flag only: must not swallow the summary
        -c|--category|-r|--replace-id|-A|--action) shift 2 ;;     # accepted but not used
        --*=*) shift ;;
        --) shift; break ;;
        -*) shift ;;
        *)  break ;;
    esac
done
summary="${1:-}"; body="${2:-}"
[ -n "$summary" ] || { echo "usage: notify-send [-a app] [-u low|normal|critical] [-i icon] [-t ms] SUMMARY [BODY]" >&2; exit 1; }
exec gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify "$(gv "$app")" 0 "$(gv "$icon")" "$(gv "$summary")" "$(gv "$body")" "[]" \
    "{'urgency': <byte $urgency>$hints}" "int32 $timeout" >/dev/null
